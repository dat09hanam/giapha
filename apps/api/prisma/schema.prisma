generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

enum FamilyStatus {
  ACTIVE
  SUSPENDED
  ARCHIVED
}

enum UserRole {
  ADMIN
  MEMBER_PLUS
  MEMBER
}

enum UserStatus {
  ACTIVE
  SUSPENDED
}

enum Gender {
  MALE
  FEMALE
  OTHER
  UNKNOWN
}

enum MaritalStatus {
  SINGLE
  MARRIED
  DIVORCED
  WIDOWED
}

enum RelationshipStatus {
  MARRIED
  SEPARATED
  DIVORCED
  WIDOWED
}

enum PosterDecorationKind {
  BACKGROUND
}

enum PosterBackgroundMode {
  TILE
  COVER
  STRETCH
}

enum FundEntryKind {
  INCOME
  EXPENSE
}

enum MeritDonationKind {
  CASH
  ITEM
}

enum FeedReactionType {
  LIKE
  LOVE
  CARE
  HAHA
  WOW
  SAD
  ANGRY
}

enum SuggestionStatus {
  PENDING
  RESOLVED
  DISMISSED
}

enum MediaKind {
  PHOTO
  DOCUMENT
}

enum MediaStatus {
  ACTIVE
  HIDDEN
  PENDING
}

model Family {
  id                    String            @id @default(uuid()) @db.Char(36)
  slug                  String            @unique @db.VarChar(100)
  name                  String            @db.VarChar(191)
  description           String?           @db.Text
  introduction          Json?
  status                FamilyStatus      @default(ACTIVE)
  deathAnniversaryDay   Int?              @db.UnsignedTinyInt
  deathAnniversaryMonth Int?              @db.UnsignedTinyInt
  address               String?           @db.VarChar(255)
  ancestryOrigin        String?           @db.VarChar(255)
  posterBackgroundId    String?           @db.Char(36)
  posterLeftText        String?           @db.VarChar(191)
  posterRightText       String?           @db.VarChar(191)
  isDemo                Boolean           @default(false)
  createdAt             DateTime          @default(now())
  updatedAt             DateTime          @updatedAt
  deletedAt             DateTime?
  users                 User[]
  people                Person[]
  relationships         Relationship[]
  media                 Media[]
  albums                Album[]
  editSuggestions       EditSuggestion[]
  feedPosts             FeedPost[]
  feedImages            FeedImage[]
  feedComments          FeedComment[]
  feedReactions         FeedReaction[]
  fundEntries           FundEntry[]
  meritEvents           MeritEvent[]
  meritDonations        MeritDonation[]
  branchManagers        BranchManager[]
  posterBackground      PosterDecoration? @relation("FamilyPosterBackground", fields: [posterBackgroundId], references: [id], onDelete: SetNull)

  @@index([status])
  @@index([deletedAt])
  @@index([isDemo])
}

model User {
  id                 String              @id @default(uuid()) @db.Char(36)
  username           String              @unique @db.VarChar(191)
  passwordHash       String              @db.VarChar(255)
  displayName        String              @db.VarChar(191)
  email              String?             @unique @db.VarChar(191)
  role               UserRole
  familyId           String?             @db.Char(36)
  status             UserStatus          @default(ACTIVE)
  mustChangePassword Boolean             @default(false)
  isShared           Boolean             @default(false)
  createdAt          DateTime            @default(now())
  updatedAt          DateTime            @updatedAt
  deletedAt          DateTime?
  family             Family?             @relation(fields: [familyId], references: [id], onDelete: Restrict)
  sessions           AuthSession[]
  branches           BranchManager[]
  passwordResetCodes PasswordResetCode[]
  uploadedMedia      Media[]             @relation("MediaUploader")

  @@index([familyId, role, status])
  @@index([deletedAt])
}

model PasswordResetCode {
  id         String    @id @default(uuid()) @db.Char(36)
  userId     String    @db.Char(36)
  codeHash   String    @db.Char(64)
  expiresAt  DateTime
  attempts   Int       @default(0) @db.UnsignedTinyInt
  consumedAt DateTime?
  createdAt  DateTime  @default(now())
  user       User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, createdAt])
  @@index([expiresAt])
}

model AuthSession {
  id        String   @id @default(uuid()) @db.Char(36)
  userId    String   @db.Char(36)
  tokenHash String   @unique @db.Char(64)
  expiresAt DateTime
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, expiresAt])
  @@index([expiresAt])
}

model Person {
  id                   String           @id @default(uuid()) @db.Char(36)
  familyId             String           @db.Char(36)
  fatherId             String?          @db.Char(36)
  motherId             String?          @db.Char(36)
  name                 String           @db.VarChar(191)
  honorific            String?          @db.VarChar(100)
  nickname             String?          @db.VarChar(191)
  courtesyName         String?          @db.VarChar(191)
  gender               Gender           @default(UNKNOWN)
  birthDate            String?          @db.VarChar(100)
  deathDate            String?          @db.VarChar(100)
  lunarDeathDay        Int?             @db.UnsignedTinyInt
  lunarDeathMonth      Int?             @db.UnsignedTinyInt
  isAlive              Boolean          @default(true)
  burialPlace          String?          @db.VarChar(255)
  phone                String?          @db.VarChar(30)
  avatarUrl            String?          @db.VarChar(500)
  biography            String?          @db.Text
  generation           Int?
  orderInFamily        Int?             @db.UnsignedSmallInt
  maritalStatus        MaritalStatus?
  education            String?          @db.VarChar(191)
  occupation           String?          @db.VarChar(191)
  hometown             String?          @db.VarChar(255)
  currentAddress       String?          @db.VarChar(255)
  mapUrl               String?          @db.VarChar(500)
  ageAtDeath           Int?             @db.UnsignedTinyInt
  worshipPlace         String?          @db.VarChar(255)
  worshipKeeperId      String?          @db.Char(36)
  deathAnniversaryText String?          @db.VarChar(191)
  createdAt            DateTime         @default(now())
  updatedAt            DateTime         @updatedAt
  family               Family           @relation(fields: [familyId], references: [id], onDelete: Cascade)
  father               Person?          @relation("FatherChildren", fields: [familyId, fatherId], references: [familyId, id], onDelete: Restrict, map: "Person_father_fkey")
  mother               Person?          @relation("MotherChildren", fields: [familyId, motherId], references: [familyId, id], onDelete: Restrict, map: "Person_mother_fkey")
  worshipKeeper        Person?          @relation("WorshipKeeper", fields: [familyId, worshipKeeperId], references: [familyId, id], onDelete: Restrict, map: "Person_worship_keeper_fkey")
  worshipKeeperOf      Person[]         @relation("WorshipKeeper")
  childrenAsFather     Person[]         @relation("FatherChildren")
  childrenAsMother     Person[]         @relation("MotherChildren")
  husbandInMarriages   Relationship[]   @relation("HusbandRelationships")
  wifeInMarriages      Relationship[]   @relation("WifeRelationships")
  uploadedMedia        Media[]          @relation("MediaAuthor")
  editSuggestions      EditSuggestion[]
  branchManagers       BranchManager[]

  @@unique([familyId, id])
  @@index([familyId, fatherId])
  @@index([familyId, motherId])
  @@index([familyId, worshipKeeperId])
  @@index([familyId, generation])
  @@index([familyId, name])
  @@index([familyId, lunarDeathMonth, lunarDeathDay])
}

model Relationship {
  id           String             @id @default(uuid()) @db.Char(36)
  familyId     String             @db.Char(36)
  husbandId    String             @db.Char(36)
  wifeId       String             @db.Char(36)
  marriageDate DateTime?          @db.Date
  status       RelationshipStatus @default(MARRIED)
  wifeOrder    Int?               @db.UnsignedTinyInt
  createdAt    DateTime           @default(now())
  updatedAt    DateTime           @updatedAt
  family       Family             @relation(fields: [familyId], references: [id], onDelete: Cascade)
  husband      Person             @relation("HusbandRelationships", fields: [familyId, husbandId], references: [familyId, id], onDelete: Restrict, map: "Relationship_husband_fkey")
  wife         Person             @relation("WifeRelationships", fields: [familyId, wifeId], references: [familyId, id], onDelete: Restrict, map: "Relationship_wife_fkey")

  @@unique([familyId, husbandId, wifeId])
  @@index([familyId, husbandId, wifeOrder])
  @@index([familyId, wifeId])
}

model Media {
  id           String      @id @default(uuid()) @db.Char(36)
  familyId     String      @db.Char(36)
  personId     String?     @db.Char(36)
  albumId      String?     @db.Char(36)
  kind         MediaKind   @default(PHOTO)
  fileUrl      String      @db.VarChar(500)
  thumbUrl     String?     @db.VarChar(500)
  contentType  String      @default("image/jpeg") @db.VarChar(100)
  sizeBytes    Int         @default(0) @db.UnsignedInt
  width        Int?        @db.UnsignedSmallInt
  height       Int?        @db.UnsignedSmallInt
  title        String?     @db.VarChar(191)
  description  String?     @db.Text
  takenOn      DateTime?   @db.Date
  status       MediaStatus @default(ACTIVE)
  uploadedById String?     @db.Char(36)
  createdAt    DateTime    @default(now())
  updatedAt    DateTime    @updatedAt
  deletedAt    DateTime?
  family       Family      @relation(fields: [familyId], references: [id], onDelete: Cascade)
  person       Person?     @relation("MediaAuthor", fields: [familyId, personId], references: [familyId, id], onDelete: Restrict, map: "Media_person_fkey")
  album        Album?      @relation(fields: [familyId, albumId], references: [familyId, id], onDelete: Cascade, map: "Media_album_fkey")
  uploadedBy   User?       @relation("MediaUploader", fields: [uploadedById], references: [id], onDelete: SetNull)

  @@index([familyId, status])
  @@index([familyId, personId])
  @@index([familyId, albumId, createdAt])
  @@index([familyId, albumId, status])
  @@index([uploadedById])
  @@index([familyId, kind, createdAt])
  @@index([deletedAt])
}

model Album {
  id          String   @id @default(uuid()) @db.Char(36)
  familyId    String   @db.Char(36)
  title       String   @db.VarChar(191)
  description String?  @db.Text
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  family      Family   @relation(fields: [familyId], references: [id], onDelete: Cascade)
  media       Media[]

  @@unique([familyId, id])
  @@index([familyId, updatedAt])
}

model PosterDecoration {
  id                   String                @id @default(uuid()) @db.Char(36)
  kind                 PosterDecorationKind
  name                 String                @db.VarChar(100)
  imageFile            String?               @db.VarChar(64)
  isActive             Boolean               @default(true)
  sortOrder            Int                   @default(0)
  backgroundMode       PosterBackgroundMode?
  insetTop             Float?
  insetRight           Float?
  insetBottom          Float?
  insetLeft            Float?
  nameInsetTop         Float?
  nameInsetRight       Float?
  nameInsetBottom      Float?
  nameInsetLeft        Float?
  nameCurve            Int                   @default(0) @db.TinyInt
  nameColor            String                @default("#ffd83a") @db.VarChar(7)
  leftTextInsetTop     Float?
  leftTextInsetRight   Float?
  leftTextInsetBottom  Float?
  leftTextInsetLeft    Float?
  leftTextColor        String                @default("#ffd83a") @db.VarChar(7)
  rightTextInsetTop    Float?
  rightTextInsetRight  Float?
  rightTextInsetBottom Float?
  rightTextInsetLeft   Float?
  rightTextColor       String                @default("#ffd83a") @db.VarChar(7)
  createdAt            DateTime              @default(now())
  updatedAt            DateTime              @updatedAt
  backgroundsOf        Family[]              @relation("FamilyPosterBackground")

  @@index([kind, isActive, sortOrder])
}

model BranchManager {
  id           String   @id @default(uuid()) @db.Char(36)
  familyId     String   @db.Char(36)
  userId       String   @db.Char(36)
  rootPersonId String   @db.Char(36)
  createdAt    DateTime @default(now())
  family       Family   @relation(fields: [familyId], references: [id], onDelete: Cascade)
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  root         Person   @relation(fields: [familyId, rootPersonId], references: [familyId, id], onDelete: Cascade, map: "BranchManager_root_fkey")

  @@unique([familyId, rootPersonId])
  @@index([userId])
}

model EditSuggestion {
  id           String           @id @default(uuid()) @db.Char(36)
  familyId     String           @db.Char(36)
  personId     String           @db.Char(36)
  proposerName String           @db.VarChar(100)
  content      String           @db.Text
  status       SuggestionStatus @default(PENDING)
  createdAt    DateTime         @default(now())
  reviewedAt   DateTime?
  family       Family           @relation(fields: [familyId], references: [id], onDelete: Cascade)
  person       Person           @relation(fields: [familyId, personId], references: [familyId, id], onDelete: Cascade, map: "EditSuggestion_person_fkey")

  @@index([familyId, status, createdAt])
  @@index([familyId, personId])
}

model FeedPost {
  id            String         @id @default(uuid()) @db.Char(36)
  familyId      String         @db.Char(36)
  authorName    String         @db.VarChar(100)
  authorKeyHash String         @db.Char(64)
  content       String         @db.Text
  createdAt     DateTime       @default(now())
  editedAt      DateTime?
  family        Family         @relation(fields: [familyId], references: [id], onDelete: Cascade)
  images        FeedImage[]
  comments      FeedComment[]
  reactions     FeedReaction[]

  @@unique([familyId, id])
  @@index([familyId, createdAt])
}

model FeedImage {
  id        String   @id @default(uuid()) @db.Char(36)
  familyId  String   @db.Char(36)
  postId    String   @db.Char(36)
  url       String   @db.VarChar(500)
  width     Int      @db.UnsignedSmallInt
  height    Int      @db.UnsignedSmallInt
  sortOrder Int      @db.UnsignedTinyInt
  family    Family   @relation(fields: [familyId], references: [id], onDelete: Cascade)
  post      FeedPost @relation(fields: [familyId, postId], references: [familyId, id], onDelete: Cascade, map: "FeedImage_post_fkey")

  @@index([familyId, postId])
  @@index([familyId, url])
}

model FeedComment {
  id            String         @id @default(uuid()) @db.Char(36)
  familyId      String         @db.Char(36)
  postId        String         @db.Char(36)
  parentId      String?        @db.Char(36)
  authorName    String         @db.VarChar(100)
  authorKeyHash String         @db.Char(64)
  replyToName   String?        @db.VarChar(100)
  content       String         @db.Text
  createdAt     DateTime       @default(now())
  editedAt      DateTime?
  family        Family         @relation(fields: [familyId], references: [id], onDelete: Cascade)
  post          FeedPost       @relation(fields: [familyId, postId], references: [familyId, id], onDelete: Cascade, map: "FeedComment_post_fkey")
  parent        FeedComment?   @relation("FeedCommentReplies", fields: [parentId], references: [id], onDelete: Cascade)
  replies       FeedComment[]  @relation("FeedCommentReplies")
  reactions     FeedReaction[]

  @@unique([familyId, id])
  @@index([familyId, postId, createdAt])
  @@index([parentId])
}

model FeedReaction {
  id             String           @id @default(uuid()) @db.Char(36)
  familyId       String           @db.Char(36)
  postId         String?          @db.Char(36)
  commentId      String?          @db.Char(36)
  reactorKeyHash String           @db.Char(64)
  reactorName    String           @db.VarChar(100)
  type           FeedReactionType
  createdAt      DateTime         @default(now())
  family         Family           @relation(fields: [familyId], references: [id], onDelete: Cascade)
  post           FeedPost?        @relation(fields: [familyId, postId], references: [familyId, id], onDelete: Cascade, map: "FeedReaction_post_fkey")
  comment        FeedComment?     @relation(fields: [familyId, commentId], references: [familyId, id], onDelete: Cascade, map: "FeedReaction_comment_fkey")

  @@unique([postId, reactorKeyHash])
  @@unique([commentId, reactorKeyHash])
  @@index([familyId])
}

model FundEntry {
  id         String        @id @default(uuid()) @db.Char(36)
  familyId   String        @db.Char(36)
  content    String        @db.VarChar(500)
  kind       FundEntryKind
  amount     BigInt        @db.UnsignedBigInt
  occurredOn DateTime      @db.Date
  createdAt  DateTime      @default(now())
  updatedAt  DateTime      @updatedAt
  family     Family        @relation(fields: [familyId], references: [id], onDelete: Cascade)

  @@index([familyId, occurredOn])
}

model MeritEvent {
  id          String          @id @default(uuid()) @db.Char(36)
  familyId    String          @db.Char(36)
  title       String          @db.VarChar(191)
  description String?         @db.VarChar(1000)
  heldOn      DateTime?       @db.Date
  createdAt   DateTime        @default(now())
  updatedAt   DateTime        @updatedAt
  family      Family          @relation(fields: [familyId], references: [id], onDelete: Cascade)
  donations   MeritDonation[]

  @@unique([familyId, id])
  @@index([familyId, createdAt])
}

model MeritDonation {
  id          String            @id @default(uuid()) @db.Char(36)
  familyId    String            @db.Char(36)
  eventId     String            @db.Char(36)
  donorName   String            @db.VarChar(100)
  kind        MeritDonationKind
  amount      BigInt?           @db.UnsignedBigInt
  itemContent String?           @db.VarChar(500)
  note        String?           @db.VarChar(500)
  donatedOn   DateTime          @db.Date
  createdAt   DateTime          @default(now())
  updatedAt   DateTime          @updatedAt
  family      Family            @relation(fields: [familyId], references: [id], onDelete: Cascade)
  event       MeritEvent        @relation(fields: [familyId, eventId], references: [familyId, id], onDelete: Cascade, map: "MeritDonation_event_fkey")

  @@index([familyId, eventId, donatedOn])
}

model PlatformFeature {
  key       String   @id @db.VarChar(50)
  enabled   Boolean  @default(true)
  updatedAt DateTime @updatedAt
}

enum ArticleCategory {
  PRAYER
  LIBRARY
}

model Article {
  id          String          @id @default(uuid()) @db.Char(36)
  category    ArticleCategory
  slug        String          @db.VarChar(160)
  title       String          @db.VarChar(200)
  summary     String?         @db.VarChar(500)
  content     Json
  coverFile   String?         @db.VarChar(64)
  isPublished Boolean         @default(false)
  publishedAt DateTime?
  createdAt   DateTime        @default(now())
  updatedAt   DateTime        @updatedAt

  @@unique([category, slug])
  @@index([category, isPublished, publishedAt])
}

enum PricingPlanTone {
  WOOD
  JADE
  GOLD
  LACQUER
}

enum PricingFeatureStyle {
  NORMAL
  BOLD
  STRIKETHROUGH
}

model PricingPlan {
  id            String                @id @default(uuid()) @db.Char(36)
  name          String                @db.VarChar(60)
  description   String?               @db.VarChar(200)
  price         Int                   @default(0)
  billingPeriod String?               @db.VarChar(20)
  icon          String                @default("sprout") @db.VarChar(30)
  tone          PricingPlanTone       @default(WOOD)
  badge         String?               @db.VarChar(40)
  isFeatured    Boolean               @default(false)
  ctaLabel      String                @db.VarChar(40)
  ctaHref       String                @db.VarChar(255)
  isActive      Boolean               @default(true)
  sortOrder     Int                   @default(0)
  features      PricingPlanFeature[]
  registrations ServiceRegistration[]
  createdAt     DateTime              @default(now())
  updatedAt     DateTime              @updatedAt

  @@index([isActive, sortOrder])
}

model PricingPlanFeature {
  id        String              @id @default(uuid()) @db.Char(36)
  planId    String              @db.Char(36)
  plan      PricingPlan         @relation(fields: [planId], references: [id], onDelete: Cascade)
  text      String              @db.VarChar(160)
  style     PricingFeatureStyle @default(NORMAL)
  sortOrder Int                 @default(0)

  @@index([planId, sortOrder])
}

enum ServiceRegistrationStatus {
  NEW
  CONTACTED
  COMPLETED
  CANCELLED
}

model ServiceRegistration {
  id        String                    @id @default(uuid()) @db.Char(36)
  planId    String?                   @db.Char(36)
  plan      PricingPlan?              @relation(fields: [planId], references: [id], onDelete: SetNull)
  planName  String                    @db.VarChar(60)
  fullName  String                    @db.VarChar(100)
  email     String                    @db.VarChar(191)
  phone     String                    @db.VarChar(30)
  consentAt DateTime
  status    ServiceRegistrationStatus @default(NEW)
  adminNote String?                   @db.VarChar(1000)
  createdAt DateTime                  @default(now())
  updatedAt DateTime                  @updatedAt

  @@index([status, createdAt])
  @@index([planId])
}
