generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

enum FamilyStatus {
  ACTIVE
  SUSPENDED
  ARCHIVED
}

enum UserRole {
  ADMIN
  MEMBER_PLUS
  MEMBER
}

enum UserStatus {
  ACTIVE
  SUSPENDED
}

enum Gender {
  MALE
  FEMALE
  OTHER
  UNKNOWN
}

model Family {
  id                       String       @id @default(uuid()) @db.Char(36)
  slug                     String       @unique @db.VarChar(100)
  name                     String       @db.VarChar(191)
  description              String?      @db.Text
  deathAnniversaryDay      Int?         @db.UnsignedTinyInt
  deathAnniversaryMonth    Int?         @db.UnsignedTinyInt
  status                   FamilyStatus @default(ACTIVE)
  createdAt                DateTime     @default(now())
  updatedAt                DateTime     @updatedAt
  users                    User[]
  people                   Person[]

  @@index([status])
}

model User {
  id           String        @id @default(uuid()) @db.Char(36)
  username     String        @unique @db.VarChar(191)
  passwordHash String        @db.VarChar(255)
  displayName  String        @db.VarChar(191)
  role         UserRole
  familyId     String?       @db.Char(36)
  status       UserStatus    @default(ACTIVE)
  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt
  family       Family?       @relation(fields: [familyId], references: [id], onDelete: Restrict)
  sessions     AuthSession[]

  @@index([familyId, role, status])
}

model AuthSession {
  id        String   @id @default(uuid()) @db.Char(36)
  userId    String   @db.Char(36)
  tokenHash String   @unique @db.Char(64)
  expiresAt DateTime
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, expiresAt])
  @@index([expiresAt])
}

model Person {
  id               String    @id @default(uuid()) @db.Char(36)
  familyId         String    @db.Char(36)
  fatherId         String?   @db.Char(36)
  motherId         String?   @db.Char(36)
  displayName      String    @db.VarChar(191)
  givenName        String?   @db.VarChar(100)
  familyName       String?   @db.VarChar(100)
  gender           Gender    @default(UNKNOWN)
  birthDate        DateTime? @db.Date
  deathDate        DateTime? @db.Date
  avatarUrl        String?   @db.VarChar(500)
  biography        String?   @db.Text
  generation       Int?
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt
  family           Family    @relation(fields: [familyId], references: [id], onDelete: Cascade)
  father           Person?   @relation("FatherChildren", fields: [familyId, fatherId], references: [familyId, id], onDelete: Restrict, map: "Person_father_fkey")
  mother           Person?   @relation("MotherChildren", fields: [familyId, motherId], references: [familyId, id], onDelete: Restrict, map: "Person_mother_fkey")
  childrenAsFather Person[]  @relation("FatherChildren")
  childrenAsMother Person[]  @relation("MotherChildren")

  @@unique([familyId, id])
  @@index([familyId, fatherId])
  @@index([familyId, motherId])
  @@index([familyId, generation])
  @@index([familyId, displayName])
}
