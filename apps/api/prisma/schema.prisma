generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

enum FamilyStatus {
  ACTIVE
  SUSPENDED
  ARCHIVED
}

enum UserRole {
  ADMIN
  MEMBER_PLUS
  MEMBER
}

enum UserStatus {
  ACTIVE
  SUSPENDED
}

enum Gender {
  MALE
  FEMALE
  OTHER
  UNKNOWN
}

enum RelationshipStatus {
  MARRIED
  SEPARATED
  DIVORCED
  WIDOWED
}

/// Only sheet backgrounds remain: each one is the sheet's whole decoration.
enum PosterDecorationKind {
  BACKGROUND
}

enum PosterBackgroundMode {
  TILE
  COVER
  /// Fills the sheet exactly; for full-sheet art that already includes its frame.
  STRETCH
}

enum FundEntryKind {
  INCOME
  EXPENSE
}

enum FeedReactionType {
  LIKE
  LOVE
  CARE
  HAHA
  WOW
  SAD
  ANGRY
}

enum SuggestionStatus {
  PENDING
  RESOLVED
  DISMISSED
}

enum MediaKind {
  PHOTO
  DOCUMENT
}

enum MediaStatus {
  ACTIVE
  HIDDEN
}

model Family {
  id                    String            @id @default(uuid()) @db.Char(36)
  slug                  String            @unique @db.VarChar(100)
  name                  String            @db.VarChar(191)
  description           String?           @db.Text
  status                FamilyStatus      @default(ACTIVE)
  deathAnniversaryDay   Int?              @db.UnsignedTinyInt
  deathAnniversaryMonth Int?              @db.UnsignedTinyInt
  address               String?           @db.VarChar(255)
  ancestryOrigin        String?           @db.VarChar(255)
  /// Phả đồ background chosen by the family head from the platform library; null shows plain paper.
  posterBackgroundId    String?           @db.Char(36)
  /// Family-specific couplet text written vertically in the background's left and right text areas.
  posterLeftText        String?           @db.VarChar(191)
  posterRightText       String?           @db.VarChar(191)
  createdAt             DateTime          @default(now())
  updatedAt             DateTime          @updatedAt
  deletedAt             DateTime?
  users                 User[]
  people                Person[]
  relationships         Relationship[]
  media                 Media[]
  albums                Album[]
  editSuggestions       EditSuggestion[]
  feedPosts             FeedPost[]
  feedImages            FeedImage[]
  feedComments          FeedComment[]
  feedReactions         FeedReaction[]
  fundEntries           FundEntry[]
  branchManagers        BranchManager[]
  posterBackground      PosterDecoration? @relation("FamilyPosterBackground", fields: [posterBackgroundId], references: [id], onDelete: SetNull)

  @@index([status])
  @@index([deletedAt])
}

model User {
  id           String          @id @default(uuid()) @db.Char(36)
  username     String          @unique @db.VarChar(191)
  passwordHash String          @db.VarChar(255)
  displayName  String          @db.VarChar(191)
  role         UserRole
  familyId     String?         @db.Char(36)
  status       UserStatus      @default(ACTIVE)
  createdAt    DateTime        @default(now())
  updatedAt    DateTime        @updatedAt
  deletedAt    DateTime?
  family       Family?         @relation(fields: [familyId], references: [id], onDelete: Restrict)
  sessions     AuthSession[]
  branches     BranchManager[]

  @@index([familyId, role, status])
  @@index([deletedAt])
}

model AuthSession {
  id        String   @id @default(uuid()) @db.Char(36)
  userId    String   @db.Char(36)
  tokenHash String   @unique @db.Char(64)
  expiresAt DateTime
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, expiresAt])
  @@index([expiresAt])
}

model Person {
  id                 String           @id @default(uuid()) @db.Char(36)
  familyId           String           @db.Char(36)
  fatherId           String?          @db.Char(36)
  motherId           String?          @db.Char(36)
  name               String           @db.VarChar(191)
  honorific          String?          @db.VarChar(100)
  nickname           String?          @db.VarChar(191)
  courtesyName       String?          @db.VarChar(191)
  gender             Gender           @default(UNKNOWN)
  birthDate          DateTime?        @db.Date
  deathDate          DateTime?        @db.Date
  lunarDeathDay      Int?             @db.UnsignedTinyInt
  lunarDeathMonth    Int?             @db.UnsignedTinyInt
  isAlive            Boolean          @default(true)
  burialPlace        String?          @db.VarChar(255)
  phone              String?          @db.VarChar(30)
  avatarUrl          String?          @db.VarChar(500)
  biography          String?          @db.Text
  generation         Int?
  orderInFamily      Int?             @db.UnsignedSmallInt
  createdAt          DateTime         @default(now())
  updatedAt          DateTime         @updatedAt
  family             Family           @relation(fields: [familyId], references: [id], onDelete: Cascade)
  father             Person?          @relation("FatherChildren", fields: [familyId, fatherId], references: [familyId, id], onDelete: Restrict, map: "Person_father_fkey")
  mother             Person?          @relation("MotherChildren", fields: [familyId, motherId], references: [familyId, id], onDelete: Restrict, map: "Person_mother_fkey")
  childrenAsFather   Person[]         @relation("FatherChildren")
  childrenAsMother   Person[]         @relation("MotherChildren")
  husbandInMarriages Relationship[]   @relation("HusbandRelationships")
  wifeInMarriages    Relationship[]   @relation("WifeRelationships")
  uploadedMedia      Media[]          @relation("MediaAuthor")
  editSuggestions    EditSuggestion[]
  branchManagers     BranchManager[]

  @@unique([familyId, id])
  @@index([familyId, fatherId])
  @@index([familyId, motherId])
  @@index([familyId, generation])
  @@index([familyId, name])
  @@index([familyId, lunarDeathMonth, lunarDeathDay])
}

model Relationship {
  id           String             @id @default(uuid()) @db.Char(36)
  familyId     String             @db.Char(36)
  husbandId    String             @db.Char(36)
  wifeId       String             @db.Char(36)
  marriageDate DateTime?          @db.Date
  status       RelationshipStatus @default(MARRIED)
  wifeOrder    Int?               @db.UnsignedTinyInt
  createdAt    DateTime           @default(now())
  updatedAt    DateTime           @updatedAt
  family       Family             @relation(fields: [familyId], references: [id], onDelete: Cascade)
  husband      Person             @relation("HusbandRelationships", fields: [familyId, husbandId], references: [familyId, id], onDelete: Restrict, map: "Relationship_husband_fkey")
  wife         Person             @relation("WifeRelationships", fields: [familyId, wifeId], references: [familyId, id], onDelete: Restrict, map: "Relationship_wife_fkey")

  @@unique([familyId, husbandId, wifeId])
  @@index([familyId, husbandId, wifeOrder])
  @@index([familyId, wifeId])
}

/// The family library (Album và tư liệu): a photo in an album, or a document such as a scanned
/// genealogy, a royal decree or a PDF. Only the clan head adds, edits or removes items; every member
/// views them. personId names the Person the item is about. Items are deleted outright together with
/// their files; deletedAt is legacy and always null.
model Media {
  id          String      @id @default(uuid()) @db.Char(36)
  familyId    String      @db.Char(36)
  personId    String?     @db.Char(36)
  albumId     String?     @db.Char(36)
  kind        MediaKind   @default(PHOTO)
  fileUrl     String      @db.VarChar(500)
  /// A small JPEG for grids and lists; null for PDFs.
  thumbUrl    String?     @db.VarChar(500)
  contentType String      @default("image/jpeg") @db.VarChar(100)
  sizeBytes   Int         @default(0) @db.UnsignedInt
  width       Int?        @db.UnsignedSmallInt
  height      Int?        @db.UnsignedSmallInt
  title       String?     @db.VarChar(191)
  description String?     @db.Text
  /// When the photo was taken or the document dated, if known.
  takenOn     DateTime?   @db.Date
  status      MediaStatus @default(ACTIVE)
  createdAt   DateTime    @default(now())
  updatedAt   DateTime    @updatedAt
  deletedAt   DateTime?
  family      Family      @relation(fields: [familyId], references: [id], onDelete: Cascade)
  person      Person?     @relation("MediaAuthor", fields: [familyId, personId], references: [familyId, id], onDelete: Restrict, map: "Media_person_fkey")
  album       Album?      @relation(fields: [familyId, albumId], references: [familyId, id], onDelete: Cascade, map: "Media_album_fkey")

  @@index([familyId, status])
  @@index([familyId, personId])
  @@index([familyId, albumId, createdAt])
  @@index([familyId, kind, createdAt])
  @@index([deletedAt])
}

/// A photo album in the family library, e.g. "Giỗ tổ 2025". Its cover is its first photo.
model Album {
  id          String   @id @default(uuid()) @db.Char(36)
  familyId    String   @db.Char(36)
  title       String   @db.VarChar(191)
  description String?  @db.Text
  createdAt   DateTime @default(now())
  /// Moves when photos are added, so recently filled albums come first.
  updatedAt   DateTime @updatedAt
  family      Family   @relation(fields: [familyId], references: [id], onDelete: Cascade)
  media       Media[]

  @@unique([familyId, id])
  @@index([familyId, updatedAt])
}

/// Platform-wide phả đồ decoration library, managed by the platform ADMIN. Not tenant-owned:
/// every Family chooses from the same library.
model PosterDecoration {
  id                   String                @id @default(uuid()) @db.Char(36)
  kind                 PosterDecorationKind
  name                 String                @db.VarChar(100)
  /// Server-generated `<uuid>.<ext>` under the decoration media folder.
  imageFile            String?               @db.VarChar(64)
  isActive             Boolean               @default(true)
  sortOrder            Int                   @default(0)
  backgroundMode       PosterBackgroundMode?
  /// The area the tree is placed in, set by the ADMIN as percent of the art's height or
  /// width in from each edge. Null: the tree sits inside the frame band.
  insetTop             Float?
  insetRight           Float?
  insetBottom          Float?
  insetLeft            Float?
  /// Where the family name is written, as percent in from each edge of the art; all four or
  /// none. Null writes no name.
  nameInsetTop         Float?
  nameInsetRight       Float?
  nameInsetBottom      Float?
  nameInsetLeft        Float?
  /// How far the name's middle rises above its ends, in percent of the name area's height;
  /// negative bends it down.
  nameCurve            Int                   @default(0) @db.TinyInt
  /// Name color as `#rrggbb`.
  nameColor            String                @default("#ffd83a") @db.VarChar(7)
  /// Optional vertical-text areas on the left and right of uploaded artwork. Each area is either
  /// fully configured or absent; colors use `#rrggbb`.
  leftTextInsetTop     Float?
  leftTextInsetRight   Float?
  leftTextInsetBottom  Float?
  leftTextInsetLeft    Float?
  leftTextColor        String                @default("#ffd83a") @db.VarChar(7)
  rightTextInsetTop    Float?
  rightTextInsetRight  Float?
  rightTextInsetBottom Float?
  rightTextInsetLeft   Float?
  rightTextColor       String                @default("#ffd83a") @db.VarChar(7)
  createdAt            DateTime              @default(now())
  updatedAt            DateTime              @updatedAt
  backgroundsOf        Family[]              @relation("FamilyPosterBackground")

  @@index([kind, isActive, sortOrder])
}

/// A family member account the family head put in charge of one chi/nhánh: rootPersonId and every
/// descendant (through either parent) plus their spouses. A root belongs to at most one manager, and the
/// service keeps one manager's branch from sitting inside another's.
model BranchManager {
  id           String   @id @default(uuid()) @db.Char(36)
  familyId     String   @db.Char(36)
  userId       String   @db.Char(36)
  rootPersonId String   @db.Char(36)
  createdAt    DateTime @default(now())
  family       Family   @relation(fields: [familyId], references: [id], onDelete: Cascade)
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  root         Person   @relation(fields: [familyId, rootPersonId], references: [familyId, id], onDelete: Cascade, map: "BranchManager_root_fkey")

  @@unique([familyId, rootPersonId])
  @@index([userId])
}

/// A change to a Person proposed by a family member for the clan head to review. Members share one
/// account, so the proposer types their own name. The head applies any change in the designer and
/// then marks the suggestion resolved or dismissed.
model EditSuggestion {
  id           String           @id @default(uuid()) @db.Char(36)
  familyId     String           @db.Char(36)
  personId     String           @db.Char(36)
  proposerName String           @db.VarChar(100)
  content      String           @db.Text
  status       SuggestionStatus @default(PENDING)
  createdAt    DateTime         @default(now())
  reviewedAt   DateTime?
  family       Family           @relation(fields: [familyId], references: [id], onDelete: Cascade)
  person       Person           @relation(fields: [familyId, personId], references: [familyId, id], onDelete: Cascade, map: "EditSuggestion_person_fkey")

  @@index([familyId, status, createdAt])
  @@index([familyId, personId])
}

/// A post on the family's news feed (Bảng tin). Everyone signs in with the family's shared account,
/// so the author types a name, and authorKeyHash (SHA-256 of a random key the posting device keeps)
/// is what lets that device edit or delete the post. The clan head may delete any post.
model FeedPost {
  id            String         @id @default(uuid()) @db.Char(36)
  familyId      String         @db.Char(36)
  authorName    String         @db.VarChar(100)
  authorKeyHash String         @db.Char(64)
  content       String         @db.Text
  createdAt     DateTime       @default(now())
  editedAt      DateTime?
  family        Family         @relation(fields: [familyId], references: [id], onDelete: Cascade)
  images        FeedImage[]
  comments      FeedComment[]
  reactions     FeedReaction[]

  @@unique([familyId, id])
  @@index([familyId, createdAt])
}

/// A photo in a post, stored under the family's media folder like avatars.
model FeedImage {
  id        String   @id @default(uuid()) @db.Char(36)
  familyId  String   @db.Char(36)
  postId    String   @db.Char(36)
  url       String   @db.VarChar(500)
  width     Int      @db.UnsignedSmallInt
  height    Int      @db.UnsignedSmallInt
  sortOrder Int      @db.UnsignedTinyInt
  family    Family   @relation(fields: [familyId], references: [id], onDelete: Cascade)
  post      FeedPost @relation(fields: [familyId, postId], references: [familyId, id], onDelete: Cascade, map: "FeedImage_post_fkey")

  @@index([familyId, postId])
  @@index([familyId, url])
}

/// A comment on a post, or a reply when parentId names a top-level comment. Replies to replies stay
/// one level deep, like Facebook, and keep the name they answer in replyToName.
model FeedComment {
  id            String         @id @default(uuid()) @db.Char(36)
  familyId      String         @db.Char(36)
  postId        String         @db.Char(36)
  parentId      String?        @db.Char(36)
  authorName    String         @db.VarChar(100)
  authorKeyHash String         @db.Char(64)
  replyToName   String?        @db.VarChar(100)
  content       String         @db.Text
  createdAt     DateTime       @default(now())
  editedAt      DateTime?
  family        Family         @relation(fields: [familyId], references: [id], onDelete: Cascade)
  post          FeedPost       @relation(fields: [familyId, postId], references: [familyId, id], onDelete: Cascade, map: "FeedComment_post_fkey")
  parent        FeedComment?   @relation("FeedCommentReplies", fields: [parentId], references: [id], onDelete: Cascade)
  replies       FeedComment[]  @relation("FeedCommentReplies")
  reactions     FeedReaction[]

  @@unique([familyId, id])
  @@index([familyId, postId, createdAt])
  @@index([parentId])
}

/// One device's reaction to a post or a comment (exactly one of postId and commentId is set).
model FeedReaction {
  id             String           @id @default(uuid()) @db.Char(36)
  familyId       String           @db.Char(36)
  postId         String?          @db.Char(36)
  commentId      String?          @db.Char(36)
  reactorKeyHash String           @db.Char(64)
  reactorName    String           @db.VarChar(100)
  type           FeedReactionType
  createdAt      DateTime         @default(now())
  family         Family           @relation(fields: [familyId], references: [id], onDelete: Cascade)
  post           FeedPost?        @relation(fields: [familyId, postId], references: [familyId, id], onDelete: Cascade, map: "FeedReaction_post_fkey")
  comment        FeedComment?     @relation(fields: [familyId, commentId], references: [familyId, id], onDelete: Cascade, map: "FeedReaction_comment_fkey")

  @@unique([postId, reactorKeyHash])
  @@unique([commentId, reactorKeyHash])
  @@index([familyId])
}

/// One line of the family fund ledger (Quỹ họ). Only the clan head writes it; every member reads
/// it. The balance is always computed from the whole ledger, never stored.
model FundEntry {
  id         String        @id @default(uuid()) @db.Char(36)
  familyId   String        @db.Char(36)
  content    String        @db.VarChar(500)
  kind       FundEntryKind
  /// Whole đồng, always positive; kind says which way it moved.
  amount     BigInt        @db.UnsignedBigInt
  /// The day the money moved, as the clan head records it; the ledger is ordered by it.
  occurredOn DateTime      @db.Date
  createdAt  DateTime      @default(now())
  updatedAt  DateTime      @updatedAt
  family     Family        @relation(fields: [familyId], references: [id], onDelete: Cascade)

  @@index([familyId, occurredOn])
}

/// A section of every family's space that the platform admin switches on or off for the whole
/// platform. A feature without a row is on.
model PlatformFeature {
  key       String   @id @db.VarChar(50)
  enabled   Boolean  @default(true)
  updatedAt DateTime @updatedAt
}
