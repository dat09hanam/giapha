# Gửi email mã OTP quên mật khẩu (SMTP). Bỏ trống SMTP_HOST thì chức năng quên mật khẩu báo chưa cấu hình.
# Môi trường dev có thể dùng Mailpit: docker compose up mailpit, rồi xem thư tại http://localhost:8025
SMTP_HOST=localhost
SMTP_PORT=1025
SMTP_SECURE=false
SMTP_USER=
