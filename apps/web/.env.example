# Mã đo lường Google Analytics 4 (dạng G-XXXXXXXXXX). Chỉ đo các trang công khai; bỏ trống thì tắt.
NEXT_PUBLIC_GA_MEASUREMENT_ID=

TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
ADMIN_NOTIFY_EMAIL=

SEPAY_WEBHOOK_API_KEY=<API key đã đặt trong SePay>
SEPAY_BANK=MBBank
SEPAY_ACCOUNT_NUMBER=0123456789
SEPAY_ACCOUNT_NAME=NGUYEN VAN A
SEPAY_CODE_PREFIX=GPDD
