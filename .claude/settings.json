{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "permissions": {
    "allow": [
      "Read",
      "Grep",
      "Glob",

      "Bash(ls *)",
      "Bash(pwd)",
      "Bash(echo *)",
      "Bash(cat *)",
      "Bash(head *)",
      "Bash(tail *)",
      "Bash(sed -n *)",
      "Bash(wc *)",
      "Bash(stat *)",
      "Bash(du *)",
      "Bash(diff *)",
      "Bash(rg *)",
      "Bash(grep *)",
      "Bash(find *)",
      "Bash(which *)",
      "Bash(node --version)",
      "Bash(npm --version)",

      "Bash(git status)",
      "Bash(git status *)",
      "Bash(git diff)",
      "Bash(git diff *)",
      "Bash(git log *)",
      "Bash(git show *)",
      "Bash(git branch)",
      "Bash(git branch --list *)",
      "Bash(git remote -v)",

      "Bash(npm run lint*)",
      "Bash(npm run typecheck*)",
      "Bash(npm run test*)",
      "Bash(npm run build*)",
      "Bash(npm run format:check*)",
      "Bash(npm run db:generate*)",
      "Bash(npm run prisma:generate*)",
      "Bash(npm run prisma:validate*)",

      "Bash(node .agents/skills/ticket/scripts/ticket.mjs *)",

      "Edit(apps/**)",
      "Edit(docs/**)",
      "Edit(tickets/**)",
      "Edit(.agents/**)",
      "Edit(.codex/**)",
      "Edit(AGENTS.md)",
      "Edit(README.md)"
    ],
    "ask": [
      "Bash(git commit*)",
      "Bash(git push*)",
      "Bash(git checkout*)",
      "Bash(git switch*)",
      "Bash(git reset*)",
      "Bash(git revert*)",
      "Bash(git stash*)",
      "Bash(git rebase*)",
      "Bash(git merge*)",
      "Bash(git worktree*)",
      "Bash(gh pr create*)",

      "Bash(npm install*)",
      "Bash(npm uninstall*)",
      "Bash(npm run db:migrate*)",
      "Bash(npm run db:deploy*)",
      "Bash(npm run db:seed*)",
      "Bash(npm run format*)",

      "Edit(package.json)",
      "Edit(package-lock.json)",
      "Edit(apps/api/prisma/**)",
      "Edit(.claude/**)"
    ],
    "deny": [
      "Read(**/.env)",
      "Read(**/.env.local)",
      "Read(**/.env.*.local)",
      "Bash(rm -rf *)",
      "Bash(npx prisma migrate reset*)",
      "Bash(npm run prisma:reset*)"
    ]
  }
}
